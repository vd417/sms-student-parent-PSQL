{
  "expo": {
    "name": "School Desk · Student",
    "slug": "sms-student",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "schooldesk-student",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0C4A6E",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.schooldesk.student"
    },
    "android": {
      "package": "com.schooldesk.student",
      "adaptiveIcon": {
        "backgroundColor": "#0C4A6E"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCLBnzIqfPTAoo_HnCVMP_nnd57nOMU7GY"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Let School Desk access your photos so you can share an image in chat."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "789277f1-7308-4b88-8b93-12fed225b44e"
      },
      "dataSource": "http",
      "apiBaseUrl": "http://localhost:5162/v1",
      "googleMapsApiKey": "AIzaSyCLBnzIqfPTAoo_HnCVMP_nnd57nOMU7GY",
      "googleMapId": "aab697c91ef02136bf693efd"
    },
    "owner": "catre"
  }
}
