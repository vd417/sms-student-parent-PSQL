{
  "expo": {
    "name": "School Desk · Student",
    "slug": "student-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "schooldesk-student",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0C4A6E",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.schooldesk.student",
      "config": {
        "googleMapsApiKey": "AIzaSyCLBnzIqfPTAoo_HnCVMP_nnd57nOMU7GY"
      }
    },
    "android": {
      "package": "com.schooldesk.student",
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C4A6E"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCLBnzIqfPTAoo_HnCVMP_nnd57nOMU7GY"
        }
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Let School Desk access your photos so you can share an image in chat."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "834d3f50-6b19-4ed3-8b6a-050fae93c858"
      },
      "dataSource": "http",
      "apiBaseUrl": "https://api.sms.catretech.me/v1",
      "googleMapsApiKey": "AIzaSyCLBnzIqfPTAoo_HnCVMP_nnd57nOMU7GY",
      "googleMapId": "aab697c91ef02136bf693efd"
    },
    "owner": "vaibhavdds-team"
  }
}
